#!/bin/sh
set -e
systemctl daemon-reload >/dev/null 2>&1 || true
if [ "$1" = purge ]; then
  echo "restaurant-crm: your data stays in Docker volumes (restaurant-crm_pg_data, restaurant-crm_uploads_data, restaurant-crm_state) and your settings and generated passwords in /etc/restaurant-crm/restaurant-crm.env, so a later reinstall picks up where you left off. To delete everything for good: sudo docker compose --project-name restaurant-crm down -v ; sudo rm -rf /etc/restaurant-crm" >&2
fi
exit 0
